# Build output: all CMake presets build into out/
out/

# Visual Studio's working folder (IntelliSense database, window layout)
.vs/

# Personal CMake presets: everyone has their own, they don't belong in the repository
CMakeUserPresets.json

# Renders saved to the project root when run from the command line
/*.png
/*.pfm

# Point lists of MonteCarlo sphere-plot, saved the same way (but CMakeLists.txt belongs to the project)
/*.txt
!/CMakeLists.txt
